# Server-side Supabase configuration. Never replace the anon key with the
# service-role key in application or browser environment variables.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-test-anon-key

# Required only by the integration-test setup. Never expose this to client code.
SUPABASE_SERVICE_ROLE_KEY=local-test-service-role-key

# Server-side Groq configuration. Never use a NEXT_PUBLIC_ prefix.
# Only use a model verified to support strict JSON Schema structured output.
GROQ_API_KEY=
GROQ_MODEL=
# Optional request timeout in milliseconds (default: 30000).
GROQ_TIMEOUT_MS=30000
